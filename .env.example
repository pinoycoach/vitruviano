# Server-only environment variables. Copy to .env.local for local dev
# (`npm run dev` serves /api with these) and set the same names in the
# Vercel project settings. NEVER prefix these with VITE_ : anything with that
# prefix is bundled into the public JavaScript.

# Google Gemini (text, images, speech, Live voice tokens)
GEMINI_API_KEY=

# ElevenLabs (WhisperBack voice)
ELEVENLABS_API_KEY=

# fal.ai (cheap image generation; optional, falls back to Gemini if unset)
FAL_KEY=

# Secret for the superuser panel. Compared server-side only; also used to sign
# the session cookie. Use a long random value, e.g. `openssl rand -hex 32`.
# If unset, superuser access is disabled entirely.
SUPERUSER_SECRET=

# --- Optional model overrides (defaults live in config/models.ts) ---
# Set these in Vercel to swap a retired model without a code change.
# GEMINI_MODEL_TEXT=
# GEMINI_MODEL_TEXT_LITE=
# GEMINI_MODEL_IMAGE=
# GEMINI_MODEL_IMAGE_FALLBACK=
# GEMINI_MODEL_TTS=
# GEMINI_MODEL_LIVE=
# ELEVENLABS_MODEL=
# FAL_MODEL=
